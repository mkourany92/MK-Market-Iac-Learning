{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "10582268671817146322"
    }
  },
  "parameters": {
    "vnetName": {
      "type": "string"
    },
    "vnetCIDR": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-04-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetCIDR')]"
          ]
        },
        "subnets": [
          {
            "name": "management",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('vnetCIDR'), 26, 0)]",
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Disabled"
            }
          },
          {
            "name": "aks",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('vnetCIDR'), 22, 1)]",
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Disabled"
            }
          },
          {
            "name": "appservice",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('vnetCIDR'), 24, 8)]",
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Disabled",
              "delegations": [
                {
                  "name": "delegation",
                  "properties": {
                    "serviceName": "Microsoft.Web/serverFarms"
                  }
                }
              ]
            }
          },
          {
            "name": "database",
            "properties": {
              "addressPrefix": "[cidrSubnet(parameters('vnetCIDR'), 24, 12)]",
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Disabled"
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "vnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
    },
    "vnetName": {
      "type": "string",
      "value": "[parameters('vnetName')]"
    },
    "managementSubnetId": {
      "type": "string",
      "value": "[format('{0}/subnets/management', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')))]"
    },
    "aksSubnetId": {
      "type": "string",
      "value": "[format('{0}/subnets/aks', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')))]"
    },
    "appserviceSubnetId": {
      "type": "string",
      "value": "[format('{0}/subnets/appservice', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')))]"
    },
    "databaseSubnetId": {
      "type": "string",
      "value": "[format('{0}/subnets/database', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')))]"
    }
  }
